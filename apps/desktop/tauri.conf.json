{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Symbiot",
  "identifier": "io.github.schulzoli.symbiot",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:8080",
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "title": "Symbiot", "width": 820, "height": 900, "minWidth": 360, "minHeight": 480 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Dein privater Graph aus Zielen, Belegen und Beziehungen",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
